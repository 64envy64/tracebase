# =============================================================================
# TraceBase — local environment template
#
# Phase 6.0 (Claude Code install path) runs entirely local-first. You do NOT
# need any of the variables below to use TraceBase today. They are scaffolded
# here for upcoming phases so the eventual cloud control plane wires into the
# same env schema.
# =============================================================================

# -----------------------------------------------------------------------------
# Phase 6.2 — hosted dashboard auth (Clerk).
# Uncomment and fill in when standing up the control-plane dashboard. The
# open-source core remains fully usable without these — the dashboard is an
# additive layer, not a replacement for local execution.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TRACEBASE_PUBLIC_APP_URL=https://tracebase.com
# TRACEBASE_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/tracebase

# -----------------------------------------------------------------------------
# Phase 6.2 — workspace/org routing (Clerk-backed).
# Left here as a placeholder; the CLI does not read these in Phase 6.0.
# -----------------------------------------------------------------------------
# TRACEBASE_WORKSPACE_ID=
# TRACEBASE_ORG_ID=

# -----------------------------------------------------------------------------
# Phase 6.2 — dashboard API endpoint (control plane). The CLI will pick up
# the session established in the dashboard via a short browser approval flow.
# -----------------------------------------------------------------------------
# TRACEBASE_API_URL=https://api.tracebase.local

# -----------------------------------------------------------------------------
# Phase 6.3 — Daytona-backed benchmark runner (reproducible evals only,
# NOT a product dependency). Core stays independent of Daytona.
# -----------------------------------------------------------------------------
# DAYTONA_API_KEY=
# DAYTONA_API_URL=

# -----------------------------------------------------------------------------
# Billing — Phase 6.2 wires shells only; billing itself is not enabled.
# Leave unset until explicitly turned on in a later phase.
# -----------------------------------------------------------------------------
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
