# =============================================================================
# TraceBase — local environment template
#
# Phase 6.0 (Claude Code install path) runs entirely local-first. You do NOT
# need any of the variables below to use TraceBase today. They are scaffolded
# here for upcoming phases so the eventual cloud control plane wires into the
# same env schema.
# =============================================================================

# -----------------------------------------------------------------------------
# Phase 6.2 — hosted dashboard auth (Clerk).
# Uncomment and fill in when standing up the control-plane dashboard. The
# open-source core remains fully usable without these — the dashboard is an
# additive layer, not a replacement for local execution.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_APP_URL=https://tracebase.ink
# TRACEBASE_PUBLIC_APP_URL=https://tracebase.ink
# TRACEBASE_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/tracebase

# -----------------------------------------------------------------------------
# Phase 6.2 — workspace/org routing (Clerk-backed).
# Left here as a placeholder; the CLI does not read these in Phase 6.0.
# -----------------------------------------------------------------------------
# TRACEBASE_WORKSPACE_ID=
# TRACEBASE_ORG_ID=

# -----------------------------------------------------------------------------
# Phase 6.2 — dashboard API endpoint (control plane). The CLI will pick up
# the session established in the dashboard via a short browser approval flow.
# -----------------------------------------------------------------------------
# TRACEBASE_API_URL=https://tracebase.ink

# -----------------------------------------------------------------------------
# Phase 6.3 — Daytona-backed benchmark runner (reproducible evals only,
# NOT a product dependency). Core stays independent of Daytona.
# -----------------------------------------------------------------------------
# DAYTONA_API_KEY=
# DAYTONA_API_URL=

# -----------------------------------------------------------------------------
# Billing — Phase 6.2 wires shells only; billing itself is not enabled.
# Leave unset until explicitly turned on in a later phase.
# -----------------------------------------------------------------------------
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Semantic applicability shadow lane (R&D, explicit opt-in).
#
# This is an inference DATA plane, separate from the dashboard control plane.
# The runtime sends only bounded + privacy-scanned DTOs. It remains shadow-only:
# semantic verdicts populate a local SWR cache and telemetry but cannot change
# served output without a separately reviewed promotion gate.
# -----------------------------------------------------------------------------
# TRACEBASE_SEMANTIC_SHADOW_URL=http://127.0.0.1:8787
# TRACEBASE_SEMANTIC_SHADOW_TOKEN=replace-with-a-long-random-bearer-token
# TRACEBASE_SEMANTIC_SHADOW_ATTESTATION={"model":"Qwen/Qwen3-Reranker-0.6B","revision":"e61197ed45024b0ed8a2d74b80b4d909f1255473","backend":"qwen-local","featureVersion":1}

# Customer-managed semantic sidecar (enterprise / local R&D).
# Weights are revision-pinned and sha256-verified before the service listens.
# TRACEBASE_SEMANTIC_SIDECAR_BACKEND=qwen-local
# TRACEBASE_SEMANTIC_SIDECAR_HOST=127.0.0.1
# TRACEBASE_SEMANTIC_SIDECAR_PORT=8787
# TRACEBASE_SEMANTIC_SIDECAR_TOKEN=replace-with-the-same-long-random-bearer-token
# TRACEBASE_SEMANTIC_SIDECAR_TENANT=local-team
# TRACEBASE_SEMANTIC_SIDECAR_QWEN_COMMAND=python
# TRACEBASE_SEMANTIC_SIDECAR_QWEN_MODEL_DIR=.models/qwen3-reranker-0.6b
# TRACEBASE_SEMANTIC_SIDECAR_QWEN_REVISION=e61197ed45024b0ed8a2d74b80b4d909f1255473
