{
  "name": "tracebase-ai",
  "version": "0.9.0",
  "description": "Reasoning layer for AI agents — institutional memory so your agents never solve the same problem twice",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "tracebase": "dist/cli.js",
    "tracebase-ai": "dist/cli.js",
    "tracebase-semantic-sidecar": "dist/semantic-sidecar.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.mjs",
      "require": "./dist/mcp.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.check.json",
    "bench:hooks": "tsx scripts/bench-hooks.ts",
    "bench:sdk": "tsx scripts/bench-sdk.ts",
    "bench:mechanisms": "tsx scripts/bench-mechanisms.ts",
    "bench:gate": "tsx scripts/bench-gate.ts",
    "demo:cross-agent": "tsx scripts/cross-agent-report.ts",
    "demo:yc:setup": "tsx scripts/yc-demo/setup.ts",
    "demo:yc:clean": "tsx scripts/yc-demo/setup.ts --clean",
    "eval:retrieval": "tsx eval/retrieval/runner.ts",
    "smoke:agent": "tsx scripts/agent-smoke.ts",
    "smoke:capabilities": "tsx scripts/capability-matrix-smoke.ts",
    "smoke:semantic-ops": "tsx scripts/semantic-bakeoff/semantic-ops-smoke.ts",
    "smoke:semantic-soak": "tsx scripts/semantic-bakeoff/semantic-soak-smoke.ts",
    "smoke:semantic-dogfood": "tsx scripts/semantic-bakeoff/semantic-dogfood-e2e-smoke.ts",
    "semantic:sidecar": "tsx bin/semantic-sidecar.ts",
    "semantic:sidecar:verify-supply-chain": "tsx scripts/semantic-bakeoff/verify-sidecar-supply-chain.ts",
    "semantic:sidecar:prepare-wheelhouse": "tsx scripts/semantic-bakeoff/prepare-sidecar-wheelhouse.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.7.0",
    "commander": "^13.1.0",
    "picocolors": "^1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0",
    "openai": ">=4.70.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "agents",
    "memory",
    "reasoning",
    "llm",
    "rag",
    "mcp",
    "institutional-memory",
    "compound-ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tracebase/tracebase"
  },
  "homepage": "https://tracebase.ink"
}
